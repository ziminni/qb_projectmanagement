# =============================================
# BuildPro CPMS — backend environment template
# Copy to `backend/.env` and adjust. Never commit the real .env.
# =============================================

# --- Django core ---
DJANGO_SECRET_KEY=django-insecure-cpms-dev-only-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL (matches the `db` service in docker-compose.yml) ---
POSTGRES_DB=buildpro_cpms
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- POS integration (Repo #1) ---
# host.docker.internal resolves to the host via docker-compose extra_hosts.
POS_API_BASE_URL=http://host.docker.internal:8000
POS_API_TIMEOUT=15
POS_API_TOKEN=
POS_API_VERIFY_SSL=True

# Lifetime (hours) of a digitally generated material release token.
RELEASE_TOKEN_TTL_HOURS=72