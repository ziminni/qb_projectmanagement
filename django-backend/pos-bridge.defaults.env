# Demo defaults for the POS bridge, loaded BEFORE django-backend/.env by
# docker-compose.yml, so any value set in .env wins. These work when POS runs in
# Docker on the same PC (its seeded cpms_service account). For POS on another PC,
# set POS_API_BASE_URL (the tunnel's https URL) and POS_API_GATEWAY_HEADER_* in
# django-backend/.env — see README "Connecting to POS".
POS_API_BASE_URL=http://host.docker.internal:8000
POS_API_ALLOW_INSECURE_LOCAL=True
POS_API_SERVICE_USERNAME=cpms_service
POS_API_SERVICE_PASSWORD=demo1234
