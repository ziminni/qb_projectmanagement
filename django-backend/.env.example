# =============================================
# BuildPro CPMS — backend environment template
# Copy to `django-backend/.env` (or `cp .env.example .env` at the repo root for
# docker-compose) and adjust. Never commit the real .env.
#
# Two modes, one switch: DJANGO_DEBUG.
#   * True  (default) — dev conveniences: wildcard hosts, wildcard CORS.
#   * False          — the backend REFUSES to start while DJANGO_SECRET_KEY is
#                      unset/the dev default, DJANGO_ALLOWED_HOSTS is `*`, or
#                      CORS_ALLOW_ALL_ORIGINS is true. See docs/DEPLOYMENT.md.
# =============================================

# --- Django core ---
# Generate a real key: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=django-insecure-cpms-dev-only-key-change-me-in-production
DJANGO_DEBUG=True
# Comma-separated. In production name the exact host(s), no wildcard.
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL (matches the `db` service in docker-compose.yml) ---
# docker-compose reads these to create the container; Django reads them to connect.
POSTGRES_DB=buildpro_cpms
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS ---
# Dev convenience. Production: CORS_ALLOW_ALL_ORIGINS=False plus explicit origins.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Production transport (only read when DJANGO_DEBUG=False) ---
# Cloudflare Tunnel forwards X-Forwarded-Proto, so Django trusts that header,
# marks cookies secure and sends HSTS for this many seconds (default one year).
# SECURE_HSTS_SECONDS=31536000

# --- Rate limits (DRF throttle scopes; defaults in config/settings.py) ---
# THROTTLE_ANON=60/min
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=10/min            # per client IP
# THROTTLE_LOGIN_EMAIL=5/min       # per account (normalized email)
# THROTTLE_PASSWORD_RESET=5/min

# --- POS integration (Repo #1) ---
# host.docker.internal resolves to the host via docker-compose extra_hosts.
# HTTPS is required. For a loopback/LAN store only, set the explicit escape
# hatch below — it is refused for a public origin.
POS_API_BASE_URL=http://host.docker.internal:8000
POS_API_ALLOW_INSECURE_LOCAL=True
POS_API_TIMEOUT=15
POS_API_VERIFY_SSL=True
# Service account the live bridge authenticates as (rotating JWT; no static token).
POS_API_SERVICE_USERNAME=cpms_service
POS_API_SERVICE_PASSWORD=demo1234
# POS_API_GATEWAY_HEADER_NAME=
# POS_API_GATEWAY_HEADER_VALUE=

# --- Durable POS outbox (`manage.py run_pos_outbox`) ---
# POS_OUTBOX_MAX_ATTEMPTS=5
# POS_OUTBOX_BACKOFF_SECONDS=30
# POS_OUTBOX_BACKOFF_MAX_SECONDS=3600
# POS_OUTBOX_POLL_SECONDS=5
# POS_AUTO_REFRESH_SECONDS=15
# POS_STATUS_STALE_AFTER_SECONDS=300

# --- Uploads ---
# DJANGO_MEDIA_ROOT=/app/private_media
# DOCUMENT_UPLOAD_MAX_BYTES=26214400
# PHOTO_UPLOAD_MAX_BYTES=10485760

# Lifetime (hours) of a digitally generated material release token.
RELEASE_TOKEN_TTL_HOURS=72
