<mxfile host="drawio"><diagram name="Figure 1. Input-Process-Output (IPO) Conceptual Framework"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="INPUT" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#e8eaf6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="320" height="36" as="geometry"/></mxCell><mxCell id="ipo0" value="&lt;b&gt;HARDWARE STORE&lt;/b&gt;&lt;br&gt;&amp;bull; Product catalog data&lt;br&gt;&amp;bull; Walk-in sales transaction data&lt;br&gt;&amp;bull; Supplier delivery records&lt;br&gt;&amp;bull; Inventory stock count&lt;br&gt;&amp;bull; User login credentials&lt;br&gt;&lt;br&gt;&lt;b&gt;CONSTRUCTION SITE&lt;/b&gt;&lt;br&gt;&amp;bull; Project profile, budget categories and site location&lt;br&gt;&amp;bull; Client and site engineer acceptance&lt;br&gt;&amp;bull; Site material counts and typed material requests&lt;br&gt;&amp;bull; Daily reports: manpower, work done, materials used, photos&lt;br&gt;&amp;bull; Worker attendance&lt;br&gt;&amp;bull; Delivery confirmations&lt;br&gt;&amp;bull; Progress billings and variation orders&lt;br&gt;&lt;br&gt;&lt;b&gt;SYSTEM AND USERS&lt;/b&gt;&lt;br&gt;&amp;bull; User roles and access levels (RBAC)&lt;br&gt;&amp;bull; Business rules (collectible debt, budgets, payroll deductions)&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="320" height="400" as="geometry"/></mxCell><mxCell id="n3" value="PROCESS" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#e8f5e9;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="320" height="36" as="geometry"/></mxCell><mxCell id="ipo1" value="&lt;b&gt;HARDWARE POS AND INVENTORY&lt;/b&gt;&lt;br&gt;&amp;bull; User authentication and authorization&lt;br&gt;&amp;bull; Walk-in sales processing&lt;br&gt;&amp;bull; Inventory update and stock adjustment&lt;br&gt;&amp;bull; Supplier delivery management&lt;br&gt;&amp;bull; Low-stock alert triggering&lt;br&gt;&amp;bull; Own-store order fulfillment&lt;br&gt;&amp;bull; Collectible debt logging&lt;br&gt;&lt;br&gt;&lt;b&gt;CONSTRUCTION MANAGEMENT&lt;/b&gt;&lt;br&gt;&amp;bull; Project creation with client and engineer acceptance&lt;br&gt;&amp;bull; Schedule, to-do and daily report management&lt;br&gt;&amp;bull; Forced site count and material request&lt;br&gt;&amp;bull; Own-store ordering and other-store purchase logging&lt;br&gt;&amp;bull; Delivery confirmation and site inventory&lt;br&gt;&amp;bull; Attendance and payroll processing&lt;br&gt;&amp;bull; Billing, variation order and payment tracking&lt;br&gt;&lt;br&gt;&lt;b&gt;API DATA EXCHANGE&lt;/b&gt;&lt;br&gt;&amp;bull; Own-store order transmission&lt;br&gt;&amp;bull; Stock deduction when an order is released&lt;br&gt;&amp;bull; Fulfillment status synchronization&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="350" y="56" width="320" height="400" as="geometry"/></mxCell><mxCell id="n4" value="OUTPUT" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#ffebee;" vertex="1" parent="1"><mxGeometry x="680" y="20" width="320" height="36" as="geometry"/></mxCell><mxCell id="ipo2" value="&lt;b&gt;HARDWARE STORE SYSTEM&lt;/b&gt;&lt;br&gt;&amp;bull; Sales receipts and invoices&lt;br&gt;&amp;bull; Real-time inventory status&lt;br&gt;&amp;bull; Low-stock alerts&lt;br&gt;&amp;bull; Sales and transaction reports&lt;br&gt;&amp;bull; Collectibles (utang) aging report&lt;br&gt;&amp;bull; Supplier delivery logs&lt;br&gt;&lt;br&gt;&lt;b&gt;CONSTRUCTION SYSTEM&lt;/b&gt;&lt;br&gt;&amp;bull; Material order slips and purchase records (PDF)&lt;br&gt;&amp;bull; Site inventory and count differences&lt;br&gt;&amp;bull; Daily site reports (PDF)&lt;br&gt;&amp;bull; Payroll sheets (PDF)&lt;br&gt;&amp;bull; Expense reports: budget vs. actual (PDF)&lt;br&gt;&amp;bull; Progress, billing and client portal views&lt;br&gt;&lt;br&gt;&lt;b&gt;INTEGRATED SYSTEM&lt;/b&gt;&lt;br&gt;&amp;bull; Queen Builders distributed information system&lt;br&gt;&amp;bull; Unified reporting and analytics dashboard&lt;br&gt;&amp;bull; Audit logs with user ID and timestamp&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="56" width="320" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>